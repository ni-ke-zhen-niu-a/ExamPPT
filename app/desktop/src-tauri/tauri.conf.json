{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExamPPT",
  "version": "0.0.1",
  "identifier": "io.github.examppt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ExamPPT · PDF试卷无损转PPT 工具",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/examppt-core"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
